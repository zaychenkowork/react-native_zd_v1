{
  "RN Primitive Wrapper": {
    "prefix": ["rnp", "primitive-wrapper"],
    "body": [
      "export {",
      "  Root as ${1:ComponentName}Root,",
      "  ${2:Indicator} as ${1:ComponentName}${2:Indicator},",
      "} from '@rn-primitives/${3:package-name}';",
      "",
      "export type { ${1:ComponentName}RootProps } from '@rn-primitives/${3:package-name}';",
      ""
    ],
    "description": "Primitive wrapper file in src/components/primitives/<name>.tsx"
  },
  "RN Styled Component from Local Primitive": {
    "prefix": ["rnui", "styled-component"],
    "body": [
      "import React from 'react';",
      "import { StyleSheet } from 'react-native-unistyles';",
      "",
      "import { ${1:ComponentName}Root } from '@/components/primitives/${2:primitive-name}';",
      "import type { ${1:ComponentName}RootProps } from '@/components/primitives/${2:primitive-name}';",
      "",
      "type Props = ${1:ComponentName}RootProps;",
      "",
      "export const ${1:ComponentName} = React.forwardRef<",
      "  React.ElementRef<typeof ${1:ComponentName}Root>,",
      "  Props",
      ">(({ style, ...props }, ref) => {",
      "  return (",
      "    <${1:ComponentName}Root ref={ref} style={[styles.root, style]} {...props}>",
      "      {props.children}",
      "    </${1:ComponentName}Root>",
      "  );",
      "});",
      "",
      "${1:ComponentName}.displayName = '${1:ComponentName}';",
      "",
      "const styles = StyleSheet.create((theme) => ({",
      "  root: {",
      "    $0",
      "  },",
      "}));",
      ""
    ],
    "description": "Styled component in src/components/ui/<Name>.tsx — imports from local primitives folder"
  }
}
