{
  "name": "react-native_zd_v1",
  "main": "index.ts",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"{src,__tests__}/**/*.{ts,tsx}\"",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:release": "expo run:ios --configuration Release",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:release:aab": "cd android && ./gradlew bundleRelease",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:dev:simulator": "eas build --profile development-simulator --platform ios",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios",
    "eas:prod:android": "eas build --profile production --platform android",
    "eas:prod:ios:submit": "eas build --profile production --platform ios --auto-submit",
    "eas:prod:android:submit": "eas build --profile production --platform android --auto-submit",
    "android:setup": "node scripts/setup-android-sdk.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test .maestro",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.0",
    "app-icon-badge": "^0.1.2",
    "axios": "^1.18.1",
    "expo": "^57.0.0",
    "expo-application": "~57.0.1",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.0",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@dev-plugins/react-query": "^0.4.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/normalize-colors": "0.86.0",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "test-renderer": "^1.2.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  },
  "private": true
}
