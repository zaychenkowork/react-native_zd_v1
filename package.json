{
  "name": "react-native_zd_v1",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:release": "expo run:ios --configuration Release",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:release:aab": "cd android && ./gradlew bundleRelease",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:dev:simulator": "eas build --profile development-simulator --platform ios",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios",
    "eas:prod:android": "eas build --profile production --platform android",
    "eas:prod:ios:submit": "eas build --profile production --platform ios --auto-submit",
    "eas:prod:android:submit": "eas build --profile production --platform android --auto-submit",
    "android:setup": "node scripts/setup-android-sdk.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "app-icon-badge": "^0.1.2",
    "axios": "^1.13.5",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.8.12",
    "react": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.33.9",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-unistyles": "^3.0.24",
    "react-native-worklets": "^0.5.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@dev-plugins/react-query": "^0.4.0",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19",
    "babel-jest": "^30.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.17",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
