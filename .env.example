# App environment (dev | stg | prod)
EXPO_PUBLIC_RUN_MODE=dev

# API base URL
EXPO_PUBLIC_API_URL=https://your-api-url.com

# Enable strict env validation (set to true before prebuild)
STRICT_ENV_VALIDATION=true

# MMKV encryption key for sensitive storage (auth tokens, credentials)
# In production: store as EAS Secret via `eas secret:create` — do NOT commit real keys
EXPO_PUBLIC_MMKV_ENCRYPTION_KEY=your-secret-key-min-16-chars

