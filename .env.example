# App environment (dev | stg | prod)
EXPO_PUBLIC_RUN_MODE=dev

# API base URL
EXPO_PUBLIC_API_URL=https://your-api-url.com

# Enable strict env validation (set to true before prebuild)
STRICT_ENV_VALIDATION=true

# ℹ️  No MMKV encryption key needed here.
# The key is generated automatically on first launch and stored in
# iOS Keychain / Android Keystore via expo-secure-store.
# It is never bundled into the JS layer.
